SALON_USER=studio
# studioiam = Studio I AM (logo, ceník MyFox, Čistá pleť), generic = jiný salon; prázdné = zvolí se samo
SALON_PROFILE=
SALON_PASSWORD_HASH=GENERATE_WITH_SELFHOST_HASH_PASSWORD_SCRIPT
SALON_ORIGIN=https://salon.example.cz
# Volitelná veřejná adresa rezervací, např. https://rezervace.studioiam.cz (na ní není administrace)
SALON_PUBLIC_ORIGIN=
# E-mail o nové online rezervaci (Seznam: smtp.seznam.cz, port 465, přihlášení celým e-mailem)
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SALON_NOTIFY_EMAIL=
# SMS připomínky klientkám (den před termínem, zapínají se v Nastavení). Vyberte jednu bránu:
# smsbrana = smsbrana.cz (v jejich administraci zapněte SMS Connect, případně povolte IP adresu serveru)
# smsgate  = Váš telefon s Androidem a aplikací SMS Gateway for Android (sms-gate.app), režim Cloud server
SMS_PROVIDER=
SMSBRANA_LOGIN=
SMSBRANA_PASSWORD=
SMSGATE_USER=
SMSGATE_PASSWORD=
# Jen pro režim Local server aplikace, např. http://192.168.1.50:8080 (výchozí je cloud sms-gate.app)
SMSGATE_URL=
# Weby, které smí zobrazit rezervační formulář v okně (iframe), např. https://www.studioiam.cz
SALON_BOOKING_FRAME_ANCESTORS=
