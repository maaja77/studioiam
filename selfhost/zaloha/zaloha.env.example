# Nastavení záloh. Zkopírujte do /etc/salon-zaloha.env a nastavte práva: chmod 600 /etc/salon-zaloha.env
# Zálohy jsou šifrované heslem RESTIC_PASSWORD. Bez něj data z zálohy NEJDE obnovit:
# uložte ho i mimo server (správce hesel, papír v šuplíku).
RESTIC_PASSWORD=

# Kam se zálohuje (mimo tento server). Vyberte jednu možnost:
# 1) Backblaze B2 (doporučeno, levné, EU region): vytvořte bucket a aplikační klíč
RESTIC_REPOSITORY=b2:nazev-bucketu:salon
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# 2) Jiné S3 úložiště (Wasabi, Hetzner Object Storage…):
# RESTIC_REPOSITORY=s3:https://endpoint/nazev-bucketu/salon
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# 3) Jiný počítač přes SFTP (NAS u Vás doma, server jinde):
# RESTIC_REPOSITORY=sftp:uzivatel@nas.example.cz:/zalohy/salon
#    (SFTP potřebuje SSH klíč; jednodušší je připojit disk NAS do VM a použít možnost 4)
# 4) Složka na tomto stroji, např. připojený disk NAS nebo USB disk (ne disk téže VM!):
# RESTIC_REPOSITORY=/mnt/nas/zalohy-salon

# Které instalace zálohovat: složky s compose.yaml oddělené mezerou.
# Studio I AM je složka s repozitářem, další salony jsou v /srv/salony/<zkratka>.
SALON_DIRS="/opt/studioiam"

# Kolik záloh nechat: denní, týdenní, měsíční.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Volitelně: adresa z healthchecks.io (zdarma). Když záloha neproběhne nebo selže, přijde e-mail.
HEALTHCHECK_URL=
